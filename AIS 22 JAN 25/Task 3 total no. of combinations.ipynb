   "source": [
    "import itertools\n",
    "\n",
    "def total_combinations(lst):\n",
    "    return len(list(itertools.combinations(lst, 2)))\n",
    "\n",
    "letters = ['a', 'b', 'c']\n",
    "print(total_combinations(letters)) "
   ]
