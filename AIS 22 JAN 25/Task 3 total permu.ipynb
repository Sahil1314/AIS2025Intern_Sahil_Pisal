   "source": [
    "import itertools\n",
    "\n",
    "def total_permutations(lst):\n",
    "    return len(list(itertools.permutations(lst)))\n",
    "\n",
    "letters = ['a', 'b', 'c']\n",
    "print(total_permutations(letters))"
   ]
